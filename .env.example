# Copy to .env and fill in real values. Never commit .env.

# LLM
LLM_MODEL=groq:qwen/qwen3.8-27b
GROQ_API_KEY=
GOOGLE_API_KEY=
EMBEDDING_MODEL=models/text-embedding-004

# Postgres (container)
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
READER_DB_PASSWORD=
# Host port 5433 (not 5432) — this machine already runs a native Postgres on 5432.
APP_DATABASE_URL=postgresql://askdata_app:${APP_DB_PASSWORD}@localhost:5433/askdata
READER_DATABASE_URL=postgresql://askdata_reader:${READER_DB_PASSWORD}@localhost:5433/askdata

# Redis
REDIS_URL=redis://localhost:6379/0

# API
API_KEYS=dev-key
ADMIN_API_KEY=

# Limits
MAX_ATTEMPTS=3
MAX_ROWS=1000
MAX_PLAN_COST=1000000
STATEMENT_TIMEOUT_MS=5000

# Datasets
DEFAULT_DATASET=ipl
DATASETS_DIR=datasets/
SCHEMA_RETRIEVAL_MIN_TABLES=8

# LangSmith
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ask-data-dev
